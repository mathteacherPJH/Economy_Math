/* =========================================================
   경제수학 대시보드 — 디자인 토큰
   테마: "시장 지표선(Index Line)" — 경제 그래프의 언어를 UI 전반에 사용
   ========================================================= */
:root{
  --ink-900:#0E1626;   /* 사이드바/헤더 배경 */
  --ink-800:#16223B;   /* 사이드바 보조 배경 */
  --ink-700:#22314F;   /* 사이드바 hover */
  --paper:#FBF9F4;      /* 슬라이드 표면 */
  --paper-line:#E7E2D6; /* 슬라이드 위 미세 罫線 */
  --gold:#D9A544;       /* 포인트 — 지표선, 강조 */
  --gold-soft:#F1D9A4;
  --gain:#2F6F62;       /* 상승/정답 */
  --loss:#B85C3E;       /* 하락/주의 */
  --text-dark:#1B2333;
  --text-muted:#5B6472;
  --text-on-dark:#E7EAF2;
  --text-on-dark-muted:#8C97AF;

  --font-display:'Noto Serif KR', serif;
  --font-eyebrow:'Fraunces', serif;
  --font-body:'IBM Plex Sans KR', 'Pretendard', sans-serif;
  --font-mono:'IBM Plex Mono', monospace;

  --sidebar-w: 296px;
  --sidebar-w-collapsed: 64px;
}

*{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0;
  font-family:var(--font-body);
  color:var(--text-dark);
  background:var(--ink-900);
  overflow:hidden;
}
@media (prefers-reduced-motion: reduce){
  *{ animation-duration:0.001ms !important; transition-duration:0.001ms !important; }
}

/* ---------- 앱 레이아웃 ---------- */
.app{
  display:grid;
  grid-template-columns: var(--sidebar-w) 1fr;
  height:100vh;
  transition: grid-template-columns .28s cubic-bezier(.4,0,.2,1);
}
.app.is-collapsed{
  grid-template-columns: var(--sidebar-w-collapsed) 1fr;
}

/* ---------- 사이드바 ---------- */
.sidebar{
  background:var(--ink-900);
  border-right:1px solid rgba(255,255,255,.06);
  display:flex;
  flex-direction:column;
  overflow:hidden;
  position:relative;
}
.sidebar-header{
  display:flex;
  align-items:center;
  gap:.65rem;
  padding:1.15rem 1.1rem .9rem;
  border-bottom:1px solid rgba(255,255,255,.07);
  flex-shrink:0;
}
.brand-mark{
  width:34px; height:34px; flex-shrink:0;
  border-radius:8px;
  background:linear-gradient(155deg, var(--gold), #B9822F);
  display:flex; align-items:center; justify-content:center;
  color:var(--ink-900); font-family:var(--font-eyebrow); font-weight:600; font-size:.95rem;
}
.brand-text{ overflow:hidden; white-space:nowrap; }
.brand-title{
  font-family:var(--font-display);
  color:var(--text-on-dark);
  font-size:1.05rem;
  line-height:1.2;
  font-weight:700;
}
.brand-sub{
  font-family:var(--font-mono);
  color:var(--text-on-dark-muted);
  font-size:.66rem;
  letter-spacing:.06em;
}
.app.is-collapsed .brand-text{ display:none; }

.collapse-btn{
  margin-left:auto;
  width:28px; height:28px;
  border-radius:7px;
  border:1px solid rgba(255,255,255,.12);
  background:transparent;
  color:var(--text-on-dark-muted);
  cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
  transition:background .15s, color .15s, transform .28s;
}
.collapse-btn:hover{ background:rgba(255,255,255,.08); color:var(--text-on-dark); }
.app.is-collapsed .collapse-btn{ transform:rotate(180deg); margin-left:0; }
.app.is-collapsed .sidebar-header{ justify-content:center; }

/* 시그니처: 사이드바 상단 지표선(index line) */
.index-line{
  height:34px;
  flex-shrink:0;
  padding:0 1.1rem;
  opacity:.9;
}
.index-line svg{ width:100%; height:100%; display:block; }
.index-line path{
  fill:none;
  stroke:var(--gold);
  stroke-width:1.6;
  stroke-linecap:round;
  stroke-dasharray:220;
  stroke-dashoffset:220;
  animation:draw-line 1.6s ease forwards .2s;
}
@keyframes draw-line{ to{ stroke-dashoffset:0; } }
.app.is-collapsed .index-line{ display:none; }

.toc{
  flex:1;
  overflow-y:auto;
  padding:.6rem .6rem 1.5rem;
}
.toc::-webkit-scrollbar{ width:6px; }
.toc::-webkit-scrollbar-thumb{ background:rgba(255,255,255,.14); border-radius:3px; }

.unit{
  margin-bottom:.25rem;
  border-radius:10px;
  overflow:hidden;
}
.unit-head{
  display:flex;
  align-items:center;
  gap:.7rem;
  width:100%;
  padding:.65rem .6rem;
  background:transparent;
  border:none;
  cursor:pointer;
  text-align:left;
  border-radius:10px;
  transition:background .15s;
}
.unit-head:hover{ background:var(--ink-700); }
.unit.is-open > .unit-head{ background:var(--ink-800); }
.unit.is-active > .unit-head{ background:var(--ink-700); }

.unit-num{
  font-family:var(--font-mono);
  font-size:.72rem;
  color:var(--gold);
  width:22px; flex-shrink:0;
}
.unit-title{
  font-family:var(--font-body);
  font-weight:500;
  font-size:.87rem;
  color:var(--text-on-dark);
  flex:1;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.unit-chevron{
  color:var(--text-on-dark-muted);
  flex-shrink:0;
  transition:transform .2s;
  font-size:.65rem;
}
.unit.is-open .unit-chevron{ transform:rotate(90deg); }

.app.is-collapsed .unit-title,
.app.is-collapsed .unit-chevron{ display:none; }
.app.is-collapsed .unit-head{ justify-content:center; padding:.65rem 0; }

.slide-list{
  list-style:none;
  margin:0; padding:.2rem .3rem .5rem 2.35rem;
  max-height:0;
  overflow:hidden;
  transition:max-height .25s ease;
}
.unit.is-open .slide-list{ max-height:640px; }
.app.is-collapsed .slide-list{ display:none; }

.slide-list li{ margin:.1rem 0; }
.slide-list button{
  width:100%;
  text-align:left;
  background:transparent;
  border:none;
  color:var(--text-on-dark-muted);
  font-family:var(--font-body);
  font-size:.8rem;
  padding:.4rem .55rem;
  border-radius:7px;
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:.45rem;
  transition:background .15s, color .15s;
}
.slide-list button:hover{ background:rgba(255,255,255,.06); color:var(--text-on-dark); }
.slide-list button.is-active{
  background:rgba(217,165,68,.16);
  color:var(--gold-soft);
}
.slide-type-dot{
  width:5px; height:5px; border-radius:50%;
  background:currentColor;
  opacity:.6;
  flex-shrink:0;
}

.sidebar-footer{
  padding:.8rem 1.1rem 1rem;
  border-top:1px solid rgba(255,255,255,.07);
  font-family:var(--font-mono);
  font-size:.64rem;
  color:var(--text-on-dark-muted);
  letter-spacing:.03em;
  flex-shrink:0;
}
.app.is-collapsed .sidebar-footer{ display:none; }

/* ---------- 메인(슬라이드) 영역 ---------- */
.main{
  position:relative;
  background:
    radial-gradient(circle at 1px 1px, rgba(0,0,0,.045) 1px, transparent 0) 0 0/22px 22px,
    var(--paper);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}

.stage-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:1rem 2.2rem 0;
  flex-shrink:0;
}
.stage-eyebrow{
  font-family:var(--font-mono);
  font-size:.72rem;
  letter-spacing:.08em;
  color:var(--text-muted);
}
.stage-eyebrow strong{ color:var(--gain); }
.fullscreen-btn{
  border:1px solid var(--paper-line);
  background:#fff;
  color:var(--text-muted);
  font-family:var(--font-mono);
  font-size:.72rem;
  padding:.4rem .75rem;
  border-radius:7px;
  cursor:pointer;
  display:flex; align-items:center; gap:.4rem;
}
.fullscreen-btn:hover{ border-color:var(--gold); color:var(--text-dark); }

.stage{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:1.4rem 2.4rem 1.6rem;
  overflow:hidden;
}

.slide-card{
  width:100%;
  max-width:980px;
  height:100%;
  max-height:100%;
  background:#fff;
  border:1px solid var(--paper-line);
  border-radius:16px;
  box-shadow:0 30px 60px -30px rgba(14,22,38,.35);
  display:flex;
  flex-direction:column;
  overflow:hidden;
}

.slide-inner{
  padding:2.4rem 3rem 2rem;
  overflow-y:auto;
  flex:1;
}
.slide-inner::-webkit-scrollbar{ width:8px; }
.slide-inner::-webkit-scrollbar-thumb{ background:var(--paper-line); border-radius:4px; }

.slide-kicker{
  font-family:var(--font-mono);
  font-size:.72rem;
  color:var(--gold);
  letter-spacing:.08em;
  margin-bottom:.5rem;
}
.slide-title{
  font-family:var(--font-display);
  font-size:2rem;
  font-weight:700;
  color:var(--text-dark);
  line-height:1.3;
  margin:0 0 .9rem;
}

/* 시그니처 모티프: 제목 아래 미니 지표선 */
.title-index{
  width:120px; height:20px;
  margin-bottom:1.6rem;
}
.title-index svg{ width:100%; height:100%; display:block; }
.title-index path{
  fill:none; stroke:var(--loss); stroke-width:2; stroke-linecap:round;
}

.slide-body{
  font-size:1.02rem;
  line-height:1.9;
  color:var(--text-dark);
  max-width:66ch;
}
.slide-body p{ margin:0 0 1.15rem; }
.slide-body strong{ color:var(--gain); font-weight:600; }
.slide-body em{ font-style:normal; color:var(--loss); font-weight:600; }
.math-box{
  font-family:var(--font-mono);
  background:#F5F1E6;
  border-left:3px solid var(--gold);
  padding:.8rem 1.1rem;
  margin:1rem 0 1.3rem;
  border-radius:0 8px 8px 0;
  font-size:.98rem;
  overflow-x:auto;
}

/* 영상 슬라이드 */
.video-wrap{
  position:relative;
  width:100%;
  max-width:760px;
  aspect-ratio:16/9;
  background:var(--ink-900);
  border-radius:10px;
  overflow:hidden;
}
.video-wrap iframe{ width:100%; height:100%; border:0; }
.video-caption{
  font-family:var(--font-mono);
  font-size:.78rem;
  color:var(--text-muted);
  margin-top:.7rem;
}

/* 게임/활동 슬라이드 */
.game-desc{ margin-bottom:1.1rem; color:var(--text-muted); }
.game-area input[type="range"]{
  width:100%;
  accent-color:var(--gold);
}
.game-readout{
  display:flex;
  gap:1.5rem;
  margin:1.1rem 0;
  font-family:var(--font-mono);
}
.game-readout div{ display:flex; flex-direction:column; gap:.2rem; }
.game-readout span{ font-size:.7rem; color:var(--text-muted); letter-spacing:.05em; }
.game-readout strong{ font-size:1.3rem; color:var(--text-dark); }
.game-result{
  padding:.8rem 1rem;
  background:#F5F1E6;
  border-radius:8px;
  font-size:.92rem;
  color:var(--loss);
  transition:background .2s, color .2s;
}
.game-result.is-correct{
  background:rgba(47,111,98,.12);
  color:var(--gain);
}

/* ---------- 하단 네비게이션 ---------- */
.stage-footer{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:1.1rem;
  padding:1rem 0 1.4rem;
  flex-shrink:0;
}
.nav-btn{
  width:38px; height:38px;
  border-radius:50%;
  border:1px solid var(--paper-line);
  background:#fff;
  color:var(--text-dark);
  cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  transition:border-color .15s, transform .1s;
}
.nav-btn:hover:not(:disabled){ border-color:var(--gold); }
.nav-btn:active:not(:disabled){ transform:scale(.94); }
.nav-btn:disabled{ opacity:.3; cursor:default; }

.progress-track{
  display:flex;
  align-items:center;
  gap:.4rem;
}
.progress-dot{
  width:6px; height:6px; border-radius:50%;
  background:var(--paper-line);
  transition:background .2s, width .2s;
}
.progress-dot.is-active{
  background:var(--gold);
  width:16px;
  border-radius:3px;
}
.progress-count{
  font-family:var(--font-mono);
  font-size:.72rem;
  color:var(--text-muted);
  margin-left:.5rem;
  min-width:52px;
}

/* ---------- 빈 상태 ---------- */
.empty-state{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  height:100%;
  text-align:center;
  color:var(--text-muted);
  gap:.6rem;
  padding:2rem;
}
.empty-state .brand-mark{ width:52px; height:52px; font-size:1.4rem; margin-bottom:.6rem; }
.empty-state h2{
  font-family:var(--font-display);
  font-size:1.4rem;
  color:var(--text-dark);
  margin:0;
}
.empty-state p{ margin:0; font-size:.92rem; max-width:34ch; }

/* ---------- 슬라이드 전환 애니메이션 ---------- */
.slide-inner{ animation:slide-in .32s cubic-bezier(.4,0,.2,1); }
@keyframes slide-in{
  from{ opacity:0; transform:translateX(14px); }
  to{ opacity:1; transform:translateX(0); }
}

/* ---------- 반응형 ---------- */
@media (max-width: 860px){
  :root{ --sidebar-w: 84vw; --sidebar-w-collapsed: 0px; }
  .app{ grid-template-columns: 0 1fr; }
  .app:not(.is-collapsed){ grid-template-columns: var(--sidebar-w) 1fr; }
  .sidebar{ position:fixed; inset:0 auto 0 0; z-index:20; width:var(--sidebar-w); box-shadow:20px 0 40px rgba(0,0,0,.25); }
  .app.is-collapsed .sidebar{ width:0; box-shadow:none; }
  .slide-inner{ padding:1.6rem 1.4rem 1.4rem; }
  .slide-title{ font-size:1.5rem; }
}
